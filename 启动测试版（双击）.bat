@echo off
chcp 65001 >nul
title Lycee 测试版（含单人测试模式）
cd /d "%~dp0"

set "VITE_DEV_TOOLS=1"

echo ============================================================
echo   Lycee Overture 对战平台 —— 测试版（含「单人测试模式」）
echo ------------------------------------------------------------
echo   启动后：主菜单里点「单人测试模式」进入战场，
echo           在战场里按 F2 打开/关闭「卡牌检索界面」，
echo           可按属性（雪/花/宙/日/月）与类别（角色/道具/场地）筛选，
echo           点一张卡即可加入手牌，或先切到「直接放到我方场上」。
echo ------------------------------------------------------------
echo   关闭方法：关掉游戏窗口 → 再关掉本窗口（或在本窗口按 Ctrl+C）
echo   注意：本窗口在运行期间不要关闭；测试版用的是另一套存档数据。
echo ============================================================
echo.

if not exist "node_modules" (
  echo [!] 还没有安装依赖，先执行一次：npm install
  echo.
  call npm install
)

echo 正在启动（第一次需要十几秒，窗口会自己弹出来）...
echo.
call npm run dev

echo.
echo [已退出] 如果上面有报错，请把报错文字截图发给维护者。
pause
